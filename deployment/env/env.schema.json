{
  "required": ["VERSION", "AI_MODE", "ENVIRONMENT"],
  "optional": ["AI_API_KEY", "WORKER_SECRET", "PDF_SALT", "MAX_TOKENS"],
  "rules": {
    "VERSION": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "AI_MODE": { "type": "string", "enum": ["mock", "live"] },
    "ENVIRONMENT": { "type": "string", "enum": ["dev", "pages", "off"] },
    "MAX_TOKENS": { "type": "string", "pattern": "^[1-9][0-9]{0,3}$" },
    "AI_API_KEY": { "type": "string", "minLength": 0, "secret": true },
    "WORKER_SECRET": { "type": "string", "minLength": 0, "secret": true },
    "PDF_SALT": { "type": "string", "minLength": 0, "secret": true }
  }
}
